{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EnterpriseDataIntelligencePlatform;Trusted_Connection=True;TrustServerCertificate=True;Connect Timeout=60;Pooling=False"
  },
  "Jwt": {
    "Issuer": "EnterpriseDataIntelligencePlatform",
    "Audience": "EDIP.Client",
    "Key": "CHANGE_THIS_DEVELOPMENT_KEY_TO_A_64_CHARACTER_SECRET_BEFORE_DEPLOYMENT",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "DefaultAdmin": {
    "Email": "admin@company.com",
    "Password": "Admin@123456",
    "FullName": "Platform Administrator"
  },
  "PasswordReset": {
    "ExpiryMinutes": 30,
    "ClientBaseUrl": "https://localhost:4200/reset-password"
  },
  "AllowedHosts": "*",
  "Ingestion": {
    "MaxFileSizeMb": 25,
    "StorageRoot": "App_Data/Imports",
    "DetailedErrorLimit": 10000
  }
}